# Large generated/reproducible artifacts and local runtime state.
# Excluded from checkpoints: GitHub rejects blobs over 100 MB, and these are
# regenerable outputs (graph builds, downloaded collector binaries, bulk data
# extracts, long-work chunk dumps) rather than source. Already-tracked paths are
# unaffected; gitignore only stops new untracked files from being added.
tools/otelcol/otelcol.exe
tools/otelcol/opentelemetry-collector-releases_otelcol_windows_amd64.tar.gz
tools/otelcol/*.tar.gz
data/fundamentals/fundamentals-quarterly-v1.jsonl
graphify-out/graph.json
scripts/graphify-out/graph.json
scripts/graphify-out/*/graph.json
state/long-work-jobs/*/chunks.jsonl
.openclaw/attachments/
.openclaw/workspace-state.json*

# Nested Claude Code worktrees are local scratch checkouts, not workspace content.
.claude/worktrees/

# Dated tmp-cleanup archives are bulk regenerable/one-off tmp output (2026-09-22 run: 653 MB, 5,889 files).
# Rollback lives on disk; do not commit. Earlier tracked archive dirs are unaffected.
09. Archive/Scripts and Tmp Cleanup - Archived/*-tmp-cleanup/
# Local skill backup zips are rollback copies of skills/ (already in git history).
09. Archive/skills-backup-*.zip
# Compiled Go helpers are rebuilt from scripts/go source (go_binary_freshness_guard.py); do not track.
scripts/go/bin/
