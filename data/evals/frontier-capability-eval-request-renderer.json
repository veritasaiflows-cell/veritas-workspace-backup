{
  "schema": "wf88.frontier_capability_eval_request_renderer.v1",
  "renderer_id": "frontier-capability-eval-request-renderer-v1",
  "version": 1,
  "status": "frozen_plumbing_pilot",
  "fixture_set_id": "frontier-capability-eval-p0-sol-terra-luna-20260808",
  "purpose": "Deterministically materialize one synthetic or public frozen case into an in-memory evaluation request.",
  "input_fields": [
    "fixture_set_id",
    "fixture_version",
    "task_class",
    "fixture_instruction_template",
    "validator_profile",
    "case.case_id",
    "case.scenario_id",
    "case.difficulty",
    "case.source_kind",
    "case.variant"
