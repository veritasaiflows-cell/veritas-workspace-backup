{
  "schema": "veritas.workflow_checkpoint_config.v1",
  "workflow_id": "WF84-WF85",
  "description": "Checkpointed review-only alerts and recommendations refresh.",
  "db_path": "state/workflow-checkpoints/wf84-wf85-checkpoints.sqlite",
  "out_path": "tmp/wf84-wf85-checkpointed-execution.json",
  "authority_boundary": {
    "review_only": true,
    "checkpoint_runner_only": true,
    "runs_existing_producers": true,
    "auto_apply_allowed": false,
    "skill_application_allowed": false,
    "delete_archive_or_move_allowed": false,
    "cron_schedule_mutation_allowed": false,
    "config_auth_runtime_mutation_allowed": false,
    "sql_or_source_mutation_allowed": false,
    "canonical_note_mutation_allowed": false,
    "maintained_portfolio_state_allowed": false,
    "maintained_simulated_account_state_allowed": false,
    "capital_order_account_or_execution_allowed": false,
    "customer_or_external_output_allowed": false,
    "owner_approval_inferred": false
  },
  "steps": [
    {
      "id": "alerts_recommendations_midday_chain",
      "command": [
        "{python}",
        "scripts/run_alerts_recommendations_chain.py",
        "midday",
        "--timeout-seconds",
        "120",
        "--write",
        "--validate"
      ],
      "expected_outputs": [
        "tmp/finance-sql-canon-access-validation.json",
        "tmp/intraday-alerts/quote-snapshot-proof.json",
        "tmp/intraday-alerts/quote-snapshot-proof-validation.json",
        "tmp/alert-level-freshness-controller.json",
        "tmp/finance-alert-os-digest.json",
        "tmp/alerts-recommendations-chain-midday.json"
      ],
      "input_paths": [
        "state/finance/finance-canon.sqlite",
        "03. Alerts and Recommendations/Alert Bands and Invalidation Register.md",
        "data/finance/universe-v1.json"
      ],
      "timeout_seconds": 600
    }
  ]
}
