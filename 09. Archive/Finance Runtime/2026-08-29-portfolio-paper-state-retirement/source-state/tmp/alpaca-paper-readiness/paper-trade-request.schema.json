{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WF67 Alpaca Paper Trade Request",
  "type": "object",
  "required": [
    "schema_version",
    "workflow",
    "artifact_type",
    "request_id",
    "created_at_utc",
    "authority",
    "order",
    "risk_check",
    "source",
    "audit"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "workflow": { "const": "WF67 - Alpaca Paper Execution Guardrail" },
    "artifact_type": { "const": "wf67_paper_trade_request" },
    "request_id": { "type": "string", "minLength": 8 },
    "created_at_utc": { "type": "string" },
    "authority": {
      "type": "object",
      "required": [
        "paper_only",
        "paper_submit_allowed",
        "paper_cancel_allowed",
        "live_submit_allowed",
        "live_cancel_allowed",
        "live_endpoint_forbidden",
        "money_movement_allowed",
        "account_settings_mutation_allowed",
        "no_inferred_approval"
      ],
      "properties": {
        "paper_only": { "const": true },
        "paper_submit_allowed": { "const": true },
        "paper_cancel_allowed": { "const": true },
        "live_submit_allowed": { "const": false },
        "live_cancel_allowed": { "const": false },
        "live_endpoint_forbidden": { "const": true },
        "money_movement_allowed": { "const": false },
        "account_settings_mutation_allowed": { "const": false },
        "no_inferred_approval": { "const": true }
      }
    },
    "order": {
      "type": "object",
      "required": ["symbol", "side", "type", "time_in_force"],
      "allOf": [
        {
          "if": { "properties": { "time_in_force": { "const": "gtc" } }, "required": ["time_in_force"] },
          "then": { "properties": { "type": { "const": "limit" } }, "required": ["type", "limit_price"] }
        }
      ],
      "properties": {
        "symbol": { "type": "string", "pattern": "^[A-Z.]{1,10}$" },
        "side": { "enum": ["buy", "sell"] },
        "type": { "enum": ["limit", "market"] },
        "time_in_force": { "enum": ["day", "gtc"] },
        "limit_price": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "qty": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "notional": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "risk_check": { "type": "object" },
    "source": { "type": "object" },
    "audit": { "type": "object" }
  }
}
