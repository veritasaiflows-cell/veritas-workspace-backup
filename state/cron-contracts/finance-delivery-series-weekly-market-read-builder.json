{
  "schema": "veritas.cron_contract.v1",
  "job_id": "59a2457f-77dc-4484-8c8a-47b0222837e1",
  "name": "Finance Delivery Series - Weekly Market Read Builder",
  "required": true,
  "owner_workflow": "WF75",
  "contract_reason": "Sunday internal weekly market read builder for Randall's recurring finance intelligence series.",
  "enabled": true,
  "schedule": {
    "kind": "cron",
    "expr": "5 17 * * 0",
    "tz": "America/Phoenix"
  },
  "sessionTarget": "isolated",
  "wakeMode": "now",
  "delivery": {
    "mode": "none",
    "bestEffort": true
  },
  "failureAlert": {
    "after": 1,
    "mode": "announce"
  },
  "payload": {
    "kind": "agentTurn",
    "model": "openai/gpt-5.4",
    "thinking": "medium",
    "timeoutSeconds": 900,
    "lightContext": false
  },
  "compare_fields": [
    "enabled",
    "schedule",
    "sessionTarget",
    "wakeMode",
    "delivery.mode",
    "delivery.bestEffort",
    "failureAlert",
    "payload.kind",
    "payload.model",
    "payload.thinking",
    "payload.timeoutSeconds",
    "payload.lightContext"
  ],
  "expected_artifacts": [
    "tmp/finance-delivery-series.json",
    "tmp/finance-delivery-series.xlsx",
    "tmp/finance-delivery-series/weekly-market-read.html",
    "tmp/finance-delivery-series/weekly-market-read.pdf"
  ],
  "authority_boundary": {
    "review_only": true,
    "cron_contract_only": true,
    "customer_or_external_delivery_allowed": false,
    "canon_or_portfolio_mutation_allowed": false,
    "capital_deployment_allowed": false,
    "paper_or_live_execution_allowed": false,
    "brokerage_or_account_action_allowed": false,
    "owner_approval_inferred": false
  }
}
