{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritas.local/schemas/candidate-packet.schema.json",
  "title": "Watchlist Promotion Candidate Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "ticker",
    "proposed_lane",
    "source_surface",
    "thesis_evidence_source",
    "canonical_trigger_source",
    "canonical_portfolio_source",
    "thesis_exists",
    "levels_exist",
    "timing_posture",
    "portfolio_competition_assessed",
    "sector_cap_checked",
    "correlated_sleeve_checked",
    "regime_score_total",
    "regime_score_rank",
    "current_watch_state",
    "current_trigger_state",
    "entry_band_defined",
    "invalidation_defined",
    "sizing_tier_defined",
    "catalyst_window_status",
    "sector",
    "correlated_sleeve",
    "sector_cap_check",
    "five_gate_status",
    "missing_gates",
    "promotion_blockers",
    "promotion_candidate",
    "promotion_review_required",
    "notes"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "ticker": {"type": "string", "minLength": 1},
    "proposed_lane": {"type": "string", "enum": ["execution", "watch", "macro", "speculative"]},
    "source_surface": {"type": "string", "minLength": 1},
    "thesis_evidence_source": {"type": "string", "minLength": 1},
    "canonical_trigger_source": {"type": "string", "minLength": 1},
    "canonical_portfolio_source": {"type": "string", "minLength": 1},
    "thesis_exists": {"type": "boolean"},
    "levels_exist": {"type": "boolean"},
    "timing_posture": {"type": "string", "enum": ["clean", "blocked", "stale", "unknown"]},
    "portfolio_competition_assessed": {"type": "boolean"},
    "sector_cap_checked": {"type": "boolean"},
    "correlated_sleeve_checked": {"type": "boolean"},
    "regime_score_total": {"type": ["number", "integer"]},
    "regime_score_rank": {"type": "integer", "minimum": 1},
    "current_watch_state": {"type": "string", "minLength": 1},
    "current_trigger_state": {"type": "string", "minLength": 1},
    "entry_band_defined": {"type": "boolean"},
    "invalidation_defined": {"type": "boolean"},
    "sizing_tier_defined": {"type": "boolean"},
    "catalyst_window_status": {"type": "string", "enum": ["clear", "warning", "blocked", "unknown"]},
    "sector": {"type": "string", "minLength": 1},
    "correlated_sleeve": {"type": "string", "minLength": 1},
    "sector_cap_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "projected_sector", "max_allowed_pct"],
      "properties": {
        "status": {"type": "string", "enum": ["pass", "warning", "failed", "unknown"]},
        "projected_sector": {"type": "string", "minLength": 1},
        "max_allowed_pct": {"type": ["number", "integer"]},
        "projected_sector_weight_pct": {"type": ["number", "integer"]}
      }
    },
    "five_gate_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thesis_gate", "macro_and_regime_gate", "technical_gate", "catalyst_gate", "risk_and_sizing_gate"],
      "properties": {
        "thesis_gate": {"$ref": "#/$defs/gateStatus"},
        "macro_and_regime_gate": {"$ref": "#/$defs/gateStatus"},
        "technical_gate": {"$ref": "#/$defs/gateStatus"},
        "catalyst_gate": {"$ref": "#/$defs/gateStatus"},
        "risk_and_sizing_gate": {"$ref": "#/$defs/gateStatus"}
      }
    },
    "missing_gates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "promotion_blockers": {
      "type": "array",
      "items": {"type": "string"}
    },
    "promotion_candidate": {"type": "boolean"},
    "promotion_review_required": {"type": "boolean", "const": true},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "candidate_weight_pct": {"type": ["number", "integer"], "minimum": 0},
    "queue_entry_required": {"type": "boolean"},
    "queue_entry_present": {"type": "boolean"},
    "proposed_action_state": {"type": "string", "enum": ["DEPLOYABLE", "DEPLOYABLE NOW", "ALMOST", "WATCH", "BLOCKED", "REPAIR", "DO NOT TOUCH"]}
  },
  "$defs": {
    "gateStatus": {
      "type": "string",
      "enum": ["pass", "warning", "failed", "missing", "unknown"]
    }
  }
}
