  "name": "Finance - Intraday Ticker Data Repair Controller",
  "required": true,
  "owner_workflow": "WF78/WF84/WF85 data-quality resilience",
  "contract_reason": "A bounded same-day repair coordinator prevents a ticker-level data mismatch from obscuring fresh independent market work while preserving a fail-closed source-open path for the affected data.",
  "description": "Review-only 15-minute same-day data-quality controller. Consolidates ticker repair proof and runs only the existing bounded quote-proof recheck when stale quote evidence exists. No fundamental source mapping, canon, portfolio, capital, trade, paper/live, brokerage, account, or approval action.",
  "enabled": true,
  "deleteAfterRun": false,
  "schedule": {
    "kind": "cron",
    "expr": "*/15 6-13 * * 1-5",
    "tz": "America/Phoenix",
    "staggerMs": 0
  },
  "sessionTarget": "isolated",
  "wakeMode": "now",
  "delivery": {
    "mode": "none",
    "bestEffort": true
  },
  "payload": {
    "kind": "command",
    "argv": [
      "python",
      "scripts/ticker_data_repair_controller.py",
      "--execute-safe",
      "--write",
      "--validate"
    ],
    "cwd": "C:\\Users\\Veritas\\.openclaw\\workspace",
    "timeoutSeconds": 360
  },
