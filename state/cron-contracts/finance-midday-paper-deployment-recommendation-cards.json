{
  "schema": "veritas.cron_contract.v1",
  "job_id": "2321c9e9-a3d6-4706-a666-fe8fc6336ebd",
  "name": "Finance - Midday Paper Deployment Recommendation Cards",
  "required": true,
  "owner_workflow": "WF78/WF67",
  "contract_reason": "Midday paper-card rebuild ties the 11:50 WF87 refresh to a fresh 12:00 review radar instead of relying on the 07:18 card snapshot.",
  "description": "Weekday review-only WF78/WF67 midday paper deployment recommendation card rebuild after the 11:50 WF87 command-center refresh. Prepares owner cards/request artifacts only; failure alerts enabled; no paper/live submit/cancel/sell/modify/approve, account action, money movement, canon/portfolio mutation, or approval inference.",
  "enabled": true,
  "schedule": {
    "kind": "cron",
    "expr": "55 11 * * 1-5",
    "tz": "America/Phoenix"
  },
  "sessionTarget": "isolated",
  "wakeMode": "now",
  "delivery": {
    "mode": "none",
    "bestEffort": true
  },
  "failureAlert": {
    "after": 1,
    "mode": "announce"
  },
  "payload": {
    "kind": "agentTurn",
    "model": "openai/gpt-5.4",
    "timeoutSeconds": 900
  },
  "compare_fields": [
    "enabled",
    "description",
    "schedule",
    "sessionTarget",
    "wakeMode",
    "delivery.mode",
    "delivery.bestEffort",
    "failureAlert",
    "payload.kind",
    "payload.model",
    "payload.timeoutSeconds"
  ],
  "expected_artifacts": [
    "tmp/morning-paper-deployment-recommendation-cards.json",
    "tmp/morning-paper-deployment-recommendation-cards.md",
    "tmp/finance-decision-sync-spine.json",
    "tmp/wf78-capital-review-queue.json",
    "tmp/finance-decision-factory.json",
    "tmp/cron-control-packet.json"
  ],
  "authority_boundary": {
    "review_only": true,
    "cron_contract_only": true,
    "cron_state_mutation_allowed": false,
    "cron_schedule_mutation_allowed": false,
    "runtime_config_mutation_allowed": false,
    "canon_or_portfolio_mutation_allowed": false,
    "capital_deployment_allowed": false,
    "paper_or_live_execution_allowed": false,
    "brokerage_or_account_action_allowed": false,
    "owner_approval_inferred": false
  }
}
