  "authority_boundary": {
    "review_only": true,
    "external_action_allowed": false,
    "route_or_runtime_mutation_allowed": false,
    "promotion_allowed": false,
    "finance_or_execution_action_allowed": false,
    "owner_approval_inferred": false
  }
