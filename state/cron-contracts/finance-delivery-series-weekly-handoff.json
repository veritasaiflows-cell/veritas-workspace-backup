  "failureAlert": {
    "after": 1,
    "mode": "announce"
  },
  "payload": {
    "kind": "systemEvent"
  },
  "compare_fields": [
    "enabled",
    "schedule",
    "sessionTarget",
    "wakeMode",
    "delivery.mode",
    "delivery.bestEffort",
    "failureAlert",
    "payload.kind"
