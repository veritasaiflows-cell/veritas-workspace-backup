    "tmp/pm-control-packet.json"
  ],
  "authority_boundary": {
    "review_only": true,
    "cron_contract_only": true,
    "main_session_handoff_only": true,
    "customer_or_external_delivery_allowed": false,
    "canon_or_portfolio_mutation_allowed": false,
    "capital_deployment_allowed": false,
