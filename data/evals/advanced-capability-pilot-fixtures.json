      },
      "measures": [
        "accepted_findings",
        "missed_contradictions",
        "duplicate_findings",
        "authority_violations",
        "wall_clock_ms",
        "total_tokens"
      ]
    },
    {
      "pilot_id": "explicit_cache_breakpoint_v1",
      "capability": "explicit_prompt_caching",
      "task_shape": "Repeat a synthetic stable-prefix evaluation while changing only the final case metadata.",
      "baseline": "gpt-5.6-terra_implicit_cache",
      "variant": "gpt-5.6-terra_explicit_cache",
      "case_set": "synthetic_stable_prefix_cases",
      "request_shape": {
        "contract_kind": "api_request_template",
        "api_request_template": {
          "model": "gpt-5.6-terra",
          "prompt_cache_key": "{{stable_synthetic_prefix_key}}",
          "prompt_cache_options": {
            "mode": "explicit"
          },
          "input": [
            {
              "type": "message",
              "role": "developer",
              "content": [
                {
                  "type": "input_text",
                  "text": "{{synthetic_stable_prefix_min_1024_tokens}}",
                  "prompt_cache_breakpoint": {
                    "mode": "explicit"
                  }
                }
              ]
            },
            {
              "type": "message",
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "{{synthetic_variable_case_metadata}}"
                }
              ]
            }
          ]
        },
        "runner_requirements": {
          "api": "responses",
          "synthetic_input_injected_at_runtime": true,
          "stable_prefix_hash_required": true,
          "minimum_cacheable_prefix_tokens": 1024,
          "rendered_prefix_token_count_verification_required": true,
          "same_prompt_cache_key_required": true,
          "variable_suffix_after_breakpoint_required": true,
          "two_request_measurement_required": true,
          "cache_write_and_read_measurement_required": true,
          "required_usage_fields": [
            "usage.input_tokens_details.cached_tokens",
            "usage.input_tokens_details.cache_write_tokens"
          ]
        }
      },
      "measures": [
        "task_complete",
        "cached_input_tokens",
        "cache_write_tokens",
        "uncached_input_tokens",
        "latency_ms",
        "estimated_cost_usd_when_pricing_available"
      ]
    },
    {
