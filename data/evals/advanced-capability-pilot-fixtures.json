  "pilots": [
    {
      "pilot_id": "structured_decision_output_v1",
      "capability": "structured_outputs",
      "task_shape": "Compile synthetic evidence metadata into one decision object that conforms to decision_object_v1.",
      "baseline": "gpt-5.5_json_validation_retry",
      "variant": "gpt-5.6-terra_strict_json_schema",
      "case_set": "synthetic_decision_contract_cases",
      "request_shape": {
        "contract_kind": "api_request_template",
        "api_request_template": {
          "model": "gpt-5.6-terra",
          "text": {
            "format": {
              "type": "json_schema",
              "name": "decision_object",
              "schema_ref": "decision_object_v1",
              "strict": true
            }
          }
        },
        "runner_requirements": {
          "api": "responses",
          "synthetic_input_injected_at_runtime": true,
          "refusal_handling_required": true
        }
      },
      "measures": [
        "schema_valid_first_pass",
        "refusal_detected",
        "authority_fields_preserved",
        "retry_count",
        "latency_ms",
        "total_tokens"
      ]
    },
    {
      "pilot_id": "programmatic_tool_recovery_v1",
      "capability": "programmatic_tool_calling",
      "task_shape": "Resolve a synthetic three-source contradiction with bounded read-only tools and one injected tool failure.",
      "baseline": "gpt-5.6-terra_standard_function_loop",
      "variant": "gpt-5.6-terra_programmatic_tool_calling",
      "case_set": "synthetic_tool_recovery_cases",
      "request_shape": {
        "contract_kind": "api_request_template",
        "api_request_template": {
          "model": "gpt-5.6-terra",
          "tools": [
            {
              "type": "programmatic_tool_calling"
            },
            {
              "type": "function",
              "name": "read_synthetic_source",
              "description": "Read one bounded synthetic evidence source by identifier.",
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_id"
                ],
                "properties": {
                  "source_id": {
                    "type": "string"
                  }
                }
              },
              "strict": true,
              "allowed_callers": [
                "programmatic"
              ]
            }
          ]
        },
        "runner_requirements": {
          "api": "responses",
          "synthetic_input_injected_at_runtime": true,
          "preserve_call_id_and_caller_linkage": true,
          "inject_one_tool_failure": true
        }
      },
      "measures": [
        "task_complete",
        "required_evidence_count",
        "tool_failure_recovered",
        "tool_calls",
        "latency_ms",
        "total_tokens"
      ]
    },
    {
      "pilot_id": "multi_agent_contradiction_audit_v1",
      "capability": "responses_multi_agent_beta",
      "task_shape": "Assign three independent synthetic evidence bundles to bounded subagents and synthesize one contradiction report.",
      "baseline": "gpt-5.6-sol_serial_single_agent",
      "variant": "gpt-5.6-sol_multi_agent_beta",
      "case_set": "synthetic_parallel_audit_cases",
      "request_shape": {
        "contract_kind": "api_request_template",
        "api_request_template": {
          "model": "gpt-5.6-sol",
          "multi_agent": {
            "enabled": true,
            "max_concurrent_subagents": 3
          }
