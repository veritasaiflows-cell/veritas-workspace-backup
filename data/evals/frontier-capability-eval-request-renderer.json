    "max_output_tokens": 12000,
    "service_tier": "standard",
    "fallback_allowed": false,
    "billable_tools_allowed": false,
    "cache_write_allowed": false,
    "tool_allowlist": []
  },
  "candidate_reasoning_effort": {
    "openai/gpt-5.6-sol": "high",
    "openai/gpt-5.6-terra": "high",
    "openai/gpt-5.6-luna": "low"
  },
  "privacy": {
    "allowed_source_kinds": [
      "synthetic",
      "public"
    ],
    "rendered_request_persisted": false,
    "raw_prompt_persisted": false,
    "raw_response_persisted": false,
    "tool_payload_persisted": false,
    "provider_payload_persisted": false,
    "secrets_or_headers_persisted": false,
    "ephemeral_output_destroyed_after_grading": true,
    "later_raw_output_regrading_supported": false
