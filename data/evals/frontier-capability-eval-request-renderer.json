  "canonicalization": "utf8-json-sort-keys-compact-v1",
  "request_envelope": {
    "system_posture": "review_only_bounded_evaluation_no_external_action",
    "instruction_source": "fixture_instruction_template",
    "case_source": "frozen_case_object",
    "response_contract": "metadata_attested_result_plus_ephemeral_candidate_output",
